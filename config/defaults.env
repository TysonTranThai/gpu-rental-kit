# =============================================================================
# GPU Rental Kit — Default Configuration
# =============================================================================
# These defaults are safe to override via environment variables.
# Do NOT commit secrets to this file.
# =============================================================================

# --- Directories (user env vars take precedence via :- syntax) ---
AI_HOME="${AI_HOME:-${HOME}/ai}"
AI_MODELS_DIR="${AI_MODELS_DIR:-${AI_HOME}/models}"
AI_CACHE_DIR="${AI_CACHE_DIR:-${AI_HOME}/cache}"
AI_PROJECTS_DIR="${AI_PROJECTS_DIR:-${AI_HOME}/projects}"
AI_CONFIG_DIR="${AI_CONFIG_DIR:-${AI_HOME}/config}"
AI_LOGS_DIR="${AI_LOGS_DIR:-${AI_HOME}/logs}"
AI_BIN_DIR="${AI_BIN_DIR:-${AI_HOME}/bin}"
AI_VENV_DIR="${AI_VENV_DIR:-${AI_HOME}/venv}"
AI_BACKUPS_DIR="${AI_BACKUPS_DIR:-${AI_HOME}/backups}"
AI_DATA_DIR="${AI_DATA_DIR:-${AI_HOME}/data}"

# --- Python ---
PYTHON_VERSION="3.11"
PIP_INDEX_URL="https://pypi.org/simple"

# --- Hugging Face ---
HF_HOME="${HF_HOME:-${AI_CACHE_DIR}/huggingface}"
HF_HUB_CACHE="${HF_HUB_CACHE:-${HF_HOME}/hub}"
HF_HUB_ENABLE_HF_TRANSFER="${HF_HUB_ENABLE_HF_TRANSFER:-1}"

# --- Model defaults ---
DEFAULT_MODEL_SOURCE="${DEFAULT_MODEL_SOURCE:-huggingface}"
MODEL_CACHE_DIR="${MODEL_CACHE_DIR:-${AI_MODELS_DIR}}"

# --- Ollama ---
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
OLLAMA_MODELS="${OLLAMA_MODELS:-${AI_MODELS_DIR}/ollama}"
OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-5m}"

# --- vLLM ---
VLLM_HOST="${VLLM_HOST:-127.0.0.1}"
VLLM_PORT="${VLLM_PORT:-8000}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-auto}"

# --- llama.cpp ---
LLAMACPP_HOST="${LLAMACPP_HOST:-127.0.0.1}"
LLAMACPP_PORT="${LLAMACPP_PORT:-8080}"

# --- Docker ---
DOCKER_AI_IMAGE="nvidia/cuda:12.4.0-runtime-ubuntu22.04"
DOCKER_AI_CONTAINER="gpu-ai-runtime"

# --- GPU Profiles (VRAM-based, informational only) ---
# <12GB  → small
# 12-15  → small-medium
# 16-23  → medium
# 24-31  → large
# 32+    → very-large

# --- GPU / Multi-GPU ---
# GPU_MODE: single (default) | auto (choose from GPU_IDS by model size)
# GPU_IDS:  comma-separated logical indices, e.g. "0,1". Empty = all GPUs.
# Aggregate VRAM across GPUs is NOT pooled — usability depends on the runtime.
GPU_MODE="${GPU_MODE:-single}"
GPU_IDS="${GPU_IDS:-}"

# --- Logging ---
LOG_LEVEL="INFO"
LOG_RETENTION_DAYS="30"

# --- Security ---
EXPOSE_PUBLICLY="false"
DEFAULT_BIND_ADDRESS="127.0.0.1"

# --- Misc ---
BOOTSTRAP_VERSION="1.1.0-beta"
RUNTIME_BACKENDS="ollama,vllm,llamacpp"