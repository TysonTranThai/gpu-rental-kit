#!/usr/bin/env bash
# =============================================================================
# ai-start — Simple interface to start AI runtimes
# =============================================================================
set -Eeuo pipefail

AI_HOME="${AI_HOME:-${HOME}/ai}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

C_RESET='\033[0m'; C_BOLD='\033[1m'; C_GREEN='\033[0;32m'; C_YELLOW='\033[0;33m'; C_CYAN='\033[0;36m'; C_RED='\033[0;31m'

# =============================================================================
# Show main menu
# =============================================================================
show_menu() {
    echo ""
    echo -e "${C_BOLD}══════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BOLD}  AI START — GPU Rental Kit${C_RESET}"
    echo -e "${C_BOLD}══════════════════════════════════════════════════════════${C_RESET}"
    echo ""
    echo "  1. Ollama"
    echo "  2. vLLM"
    echo "  3. llama.cpp"
    echo "  4. GPU status"
    echo "  5. Model list"
    echo "  6. Exit"
    echo ""
    echo -n "  Choose [1-6]: "
}

# =============================================================================
# start_ollama
# =============================================================================
start_ollama() {
    local model="${1:-}"

    if ! command -v ollama &>/dev/null; then
        echo -e "${C_RED}[ERROR]${C_RESET} Ollama not installed. Run ./bootstrap.sh first."
        return 1
    fi

    # Ensure ollama serve is running
    if ! pgrep -f "ollama serve" >/dev/null 2>&1; then
        echo -e "${C_BOLD}[ollama]${C_RESET} Starting Ollama server..."
        if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]] \
            && systemctl list-unit-files ollama.service &>/dev/null 2>&1; then
            if [[ "$(id -u)" -eq 0 ]]; then
                systemctl start ollama 2>/dev/null || true
            else
                sudo systemctl start ollama 2>/dev/null || true
            fi
        else
            nohup ollama serve > "${AI_HOME}/logs/ollama.log" 2>&1 &
            echo $! > "${AI_HOME}/logs/ollama.pid"
        fi
        sleep 2
    fi

    if [[ -n "${model}" ]]; then
        echo -e "${C_BOLD}[ollama]${C_RESET} Starting model: ${model}"
        exec ollama run "${model}"
    else
        echo -e "${C_GREEN}[OK]${C_RESET} Ollama server running."
        echo -e "  ${C_CYAN}Run a model:${C_RESET} ollama run <model>"
        echo -e "  ${C_CYAN}List models:${C_RESET} ollama list"
    fi
}

# =============================================================================
# start_vllm
# =============================================================================
start_vllm() {
    local model="${1:-}"

    if [[ ! -f "${AI_HOME}/bin/vllm-serve" ]]; then
        echo -e "${C_RED}[ERROR]${C_RESET} vLLM not configured. Run ./bootstrap.sh first."
        return 1
    fi

    if [[ -z "${model}" ]]; then
        echo -e "${C_YELLOW}Usage: ai-start vllm <MODEL>${C_RESET}"
        echo -e "  e.g. ai-start vllm Qwen/Qwen2.5-7B-Instruct"
        return 1
    fi

    echo -e "${C_BOLD}[vllm]${C_RESET} Starting vLLM with model: ${model}"
    echo -e "  OpenAI-compatible API: http://127.0.0.1:${VLLM_PORT:-8000}/v1"
    echo ""
    exec "${AI_HOME}/bin/vllm-serve" "${model}"
}

# =============================================================================
# start_llamacpp
# =============================================================================
start_llamacpp() {
    local model="${1:-}"

    if [[ ! -f "${AI_HOME}/bin/llamacpp-serve" ]]; then
        echo -e "${C_RED}[ERROR]${C_RESET} llama.cpp not configured. Run ./bootstrap.sh first."
        return 1
    fi

    if [[ -z "${model}" ]]; then
        echo -e "${C_YELLOW}Usage: ai-start llama <MODEL_PATH>${C_RESET}"
        echo -e "  e.g. ai-start llama ~/ai/models/llama-3-8b-q4.gguf"
        return 1
    fi

    echo -e "${C_BOLD}[llamacpp]${C_RESET} Starting llama.cpp with model: ${model}"
    exec "${AI_HOME}/bin/llamacpp-serve" "${model}"
}

# =============================================================================
# show_gpu_status
# =============================================================================
show_gpu_status() {
    if [[ -f "${SCRIPT_DIR}/bin/gpu-status" ]]; then
        bash "${SCRIPT_DIR}/bin/gpu-status"
    else
        nvidia-smi 2>/dev/null || echo "nvidia-smi not available"
    fi
}

# =============================================================================
# show_models
# =============================================================================
show_models() {
    if [[ -f "${SCRIPT_DIR}/bin/model-list" ]]; then
        bash "${SCRIPT_DIR}/bin/model-list"
    else
        echo "Model list not available."
    fi
}

# =============================================================================
# Main
# =============================================================================
# GPU flag delegation: any --gpu/--gpus/--gpu-mode/--size-gb/--fit flag hands
# the launch to model-run (the single GPU-selection entry point) instead of
# starting the runtime directly — one implementation, no duplicated logic.
if [[ $# -ge 1 ]]; then
    # Non-interactive mode — split args into GPU flags vs positionals
    GPU_FLAGS=()
    POSITIONALS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gpu|--gpus|--gpu-mode|--size-gb)
                GPU_FLAGS+=("$1" "${2:-}"); shift 2 ;;
            --fit)
                GPU_FLAGS+=("$1"); shift ;;
            -h|--help|help)
                echo "Usage: ai-start [ollama|vllm|llama] [MODEL]"
                echo "       ai-start                    # interactive menu"
                echo ""
                echo "Multi-GPU options (delegated to model-run):"
                echo "  ai-start vllm MODEL --gpus 0,1     # shard across GPUs 0,1"
                echo "  ai-start llama MODEL --gpus all    # shard across every GPU"
                echo "  ai-start ollama MODEL --gpu 0      # keep the model on GPU 0"
                echo "  ai-start vllm MODEL --gpus auto --size-gb 40"
                echo ""
                echo "After launch, verify GPU usage: gpu-status --expect 0,1"
                ;;
            --)
                shift; while [[ $# -gt 0 ]]; do POSITIONALS+=("$1"); shift; done ;;
            *)
                POSITIONALS+=("$1"); shift ;;
        esac
    done

    if [[ "${#GPU_FLAGS[@]}" -gt 0 ]]; then
        BACKEND="auto"
        MODEL=""
        if [[ "${#POSITIONALS[@]}" -gt 0 ]]; then
            case "${POSITIONALS[0]}" in
                ollama)                   BACKEND="ollama";   MODEL="${POSITIONALS[1]:-}" ;;
                vllm)                     BACKEND="vllm";     MODEL="${POSITIONALS[1]:-}" ;;
                llama|llamacpp|llama.cpp) BACKEND="llamacpp"; MODEL="${POSITIONALS[1]:-}" ;;
                            *)            MODEL="${POSITIONALS[0]}" ;;
            esac
        fi
        if [[ -z "${MODEL}" ]]; then
            echo -e "${C_RED}[ERROR]${C_RESET} GPU flags given but no MODEL specified." >&2
            echo "  Usage: ai-start [ollama|vllm|llama] MODEL --gpus all|0,1|auto" >&2
            exit 1
        fi
        echo -e "${C_BOLD}[ai-start]${C_RESET} Delegating to model-run (backend: ${BACKEND})..."
        exec "${SCRIPT_DIR}/bin/model-run" "${MODEL}" --backend "${BACKEND}" \
            ${GPU_FLAGS[@]+"${GPU_FLAGS[@]}"}
    fi

    # No GPU flags: original dispatch on the first positional
    case "${POSITIONALS[0]:-}" in
        ollama)
            start_ollama "${POSITIONALS[1]:-}"
            ;;
        vllm)
            start_vllm "${POSITIONALS[1]:-}"
            ;;
        llama|llamacpp|llama.cpp)
            start_llamacpp "${POSITIONALS[1]:-}"
            ;;
        status|gpu)
            show_gpu_status
            ;;
        models|list)
            show_models
            ;;
        "")
            # Degenerate input (e.g. only "--"): re-enter interactive mode
            exec "${BASH_SOURCE[0]}"
            ;;
        *)
            echo -e "${C_RED}Unknown command: ${POSITIONALS[0]}${C_RESET}"
            echo "Usage: ai-start [ollama|vllm|llama] [MODEL]"
            exit 1
            ;;
    esac
else
    # Interactive mode
    while true; do
        show_menu
        read -r choice
        case "${choice}" in
            1)
                start_ollama
                ;;
            2)
                echo -n "  Model (HF ID or path): "
                read -r model
                start_vllm "${model}"
                ;;
            3)
                echo -n "  Model (GGUF path): "
                read -r model
                start_llamacpp "${model}"
                ;;
            4)
                show_gpu_status
                ;;
            5)
                show_models
                ;;
            6|q|quit|exit)
                echo -e "${C_GREEN}Bye!${C_RESET}"
                exit 0
                ;;
            *)
                echo -e "${C_YELLOW}Invalid choice.${C_RESET}"
                ;;
        esac
    done
fi