#!/usr/bin/env bash
# =============================================================================
# gpu-test — Run GPU compute tests and lightweight benchmark
# =============================================================================
# Usage:
#   gpu-test            # standard tests (single-GPU safe)
#   gpu-test --multi    # deeper multi-GPU tests (detection, per-GPU CUDA, P2P)
#   gpu-test --bench    # optional micro-benchmark (matmul GFLOPS, P2P bandwidth)
#   gpu-test --multi --bench
# =============================================================================
set -Eeuo pipefail

# Resolve the gpu-rental-kit directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AI_HOME="${AI_HOME:-${HOME}/ai}"

GPU_TEST_FLAGS=()
for arg in "$@"; do
    case "${arg}" in
        --multi|--bench) GPU_TEST_FLAGS+=("${arg}") ;;
        -h|--help)
            echo "Usage: gpu-test [--multi] [--bench]"
            echo "  --multi   deeper multi-GPU checks (detection, per-GPU CUDA, P2P)"
            echo "  --bench   optional micro-benchmark (NOT run by default)"
            exit 0
            ;;
        *)
            echo "Unknown option: ${arg} (try --help)" >&2
            exit 1
            ;;
    esac
done

# Source detection scripts
# shellcheck source=scripts/detect_gpu.sh
source "${SCRIPT_DIR}/scripts/detect_gpu.sh"
# shellcheck source=scripts/test_gpu.sh
source "${SCRIPT_DIR}/scripts/test_gpu.sh"

# Run detection first
run_gpu_detection

# Run tests (guard: empty-array expansion fails on bash 3.2 under set -u)
run_gpu_tests ${GPU_TEST_FLAGS[@]+"${GPU_TEST_FLAGS[@]}"}

exit $?
