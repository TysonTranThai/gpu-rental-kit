#!/usr/bin/env bash
# =============================================================================
# gpu-test — Run GPU compute tests and lightweight benchmark
# =============================================================================
# Usage:
#   gpu-test           # standard tests (single-GPU safe)
#   gpu-test --multi   # deeper multi-GPU tests (detection, per-GPU CUDA, P2P)
# =============================================================================
set -Eeuo pipefail

# Resolve the gpu-rental-kit directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AI_HOME="${AI_HOME:-${HOME}/ai}"

GPU_TEST_FLAG=""
if [[ "${1:-}" == "--multi" ]]; then
    GPU_TEST_FLAG="--multi"
fi

# Source detection scripts
# shellcheck source=scripts/detect_gpu.sh
source "${SCRIPT_DIR}/scripts/detect_gpu.sh"
# shellcheck source=scripts/test_gpu.sh
source "${SCRIPT_DIR}/scripts/test_gpu.sh"

# Run detection first
run_gpu_detection

# Run tests
run_gpu_tests "${GPU_TEST_FLAG}"

exit $?
